PORT=9988
# required: admin token for the dashboard and API (min 16 chars), e.g. `openssl rand -hex 24`
ADMIN_TOKEN=
# redis password used inside the compose stack (Coolify generates its own)
SERVICE_PASSWORD_REDIS=change-me
CORS=*
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
NOTIFY_EMAIL=
NOTIFY_WEBHOOK=
NOTIFY_CHANNELS=
